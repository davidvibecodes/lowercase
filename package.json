{
  "name": "lowercase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ensure-db": "tsx scripts/ensure-db.ts",
    "dev": "npm run ensure-db && tsx watch --clear-screen=false --ignore ./src/app --ignore ./src/components --ignore ./.next server.ts",
    "build": "prisma generate && next build",
    "start": "npm run ensure-db && cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@next/env": "15.5.28",
    "@prisma/client": "6.19.3",
    "@xyflow/react": "12.12.0",
    "framer-motion": "12.43.0",
    "lucide-react": "1.57.0",
    "next": "15.5.28",
    "openid-client": "6.8.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
