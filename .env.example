# Generated automatically by scripts/ensure-db.ts on first run.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
# Enables the passwordless test login. Never enable outside local development.
AUTH_MODE=dev

# "Continue with Google". Create a Web application OAuth client in Google Cloud
# (Google Auth Platform > Clients) and paste its values here. See README.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/login/google/callback"
